#include<bits/stdc++.h>
using namespace std;
struct Node{
    int data;
    Node *next;
};
void insertatend(Node *&head,int value){
    Node *newNode=new Node;
    newNode->data=value;
    newNode->next=NULL;
    if(head==NULL){
        head=newNode;
        return;
    }
    Node*temp=head;
    while(temp->next!=NULL){
        temp=temp->next;
    }
    temp->next=newNode;
}
void display(Node *head){
    Node *temp=head;
    while(temp!=NULL){
        cout<<temp->data<<"->";
        temp=temp->next;
    }
    cout<<"NULL";
}
Node *merge(Node *&head1,Node *&head2){
    Node dummy;
    Node *temp=&dummy;
    while(head1!=NULL && head2!=NULL){
        if(head1->data <= head2->data){
            temp->next=head1;
            head1=head1->next;
        }else{
            temp->next=head2;
            head2=head2->next;
        }
        temp=temp->next;
    }
    if(head1!=NULL){
        temp->next=head1;
    }else{
        temp->next=head2;
    }
    return dummy.next;
}
int main(){
    Node *head1=NULL;
    Node *head2=NULL;
    int n1;
    cin>>n1;
    for(int i=0;i<n1;i++){
        int value;
        cin>>value;
        insertatend(head1,value);
    }
    int n2;
    cin>>n2;
    for(int i=0;i<n2;i++){
        int value;
        cin>>value;
        insertatend(head2,value);
    }
    Node *head=merge(head1,head2);
    display(head);
    return 0;
}
