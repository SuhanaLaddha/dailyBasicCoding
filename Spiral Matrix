#include<bits/stdc++.h>
using namespace std;
int main(){
    int n,m;
    cin>>n>>m;
    vector<vector<int>>mat(n,vector<int>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>mat[i][j];
        }
    }
    int top=0;
    int bottom=n-1;
    int left=0;
    int right=m-1;
    while(top<=bottom && left<=right){
        for(int j=left;j<=right;j++){
            cout<<mat[top][j]<<" ";
        }
        top++;
        for(int j=top;j<=bottom;j++){
            cout<<mat[j][right]<<" ";
        }
        right--;
        if(top<=bottom){
            for(int i=right;i>=left;i--){
                cout<<mat[bottom][i]<<" ";
            }
            bottom--;
        }
        if(left<=right){
            for(int i=bottom;i>=top;i--){
                cout<<mat[i][left]<< " ";
            }
            left++;
        }
    }
    return 0;
}
