#include<bits/stdc++.h>
using namespace std;
struct TreeNode{
    int val;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x){
        val=x;
        left=NULL;
        right=NULL;
    }
};
TreeNode* insert(TreeNode* root,int val){
    if(root==NULL){
        return new TreeNode(val);
    }else if(val<root->val){
        root->left=insert(root->left,val);
    }else{
        root->right=insert(root->right,val);
    }
    return root;
}
bool search(TreeNode* root,int val){
    if(root==NULL){
        return false;
    }
    else if(root->val==val){
        return true;
    }
    else if(val<root->val){
        return search(root->left,val);
    }
    return search(root->right,val);
}
int main(){
    TreeNode* root=NULL;
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int value;
        cin>>value;
        root=insert(root,value);
    }
    int k;
    cin>>k;
    if(search(root,k)){
        cout<<"Found";
    }else{
        cout<<"Not found";
    }
    return 0;
}
