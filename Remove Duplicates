#include<bits/stdc++.h>
using namespace std;
int removeDuplicates(vector<int>& nums,int n){
    if(n==0)return 0;
    sort(nums.begin(),nums.end());
    int j=0;
    for(int i=0;i<n;i++){
        if(nums[j]!=nums[i]){
            j++;
            nums[j]=nums[i];
        }
    }
    return j+1;
}
int main(){
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int k=removeDuplicates(nums,n)
    for(int j=0;j<k;j++){
        cout<<nums[j];
    }
    
    return 0;
}
