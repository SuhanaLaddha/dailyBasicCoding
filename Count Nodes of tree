#include<bits/stdc++.h>
using namespace std;
struct TreeNode{
    int val;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x){
        val=x;
        left=NULL;
        right=NULL;
    }
};
TreeNode* create(int n){
    if(n==0){
        return 0;
    }
    int value;
    cin>>value;

    TreeNode* root=new TreeNode(value);
    queue<TreeNode*>q;
    q.push(root);
    int count=1;
    while(count<n){
        TreeNode* current=q.front();
        q.pop();
        cin>>value;
        current->left=new TreeNode(value);
        q.push(current->left);
        count++;
        cin>>value;
        current->right=new TreeNode(value);
        q.push(current->right);
        count++;
    }
    return root;

}
int count(TreeNode* root){
    if(root==NULL){
        return 0;
    }
    return 1+count(root->left)+count(root->right);
}
int main(){
    int n;
    cin>>n;
    TreeNode* root=create(n);
    cout<<count(root);
    return 0;
}
