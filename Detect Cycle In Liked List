#include<bits/stdc++.h>
using namespace std;
struct Node{
    int data;
    Node *next;
};
void insertatend(Node *&head,int value){
    Node *newNode=new Node;
    newNode->data=value;
    newNode->next=NULL;
    if(head==NULL){
        head=newNode;
        return;
    }
    Node*temp=head;
    while(temp->next!=NULL){
        temp=temp->next;
    }
    temp->next=newNode;
}
bool DetectCycle(Node *head){
    Node *slow=head;
    Node *fast=head;
    while(fast!=NULL && fast->next!=NULL){
        slow=slow->next;
        fast=fast->next->next;
        if(slow==fast){
            return true;
        }
    }
    return false;
}
int main(){
    Node *head=NULL;
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int value;
        cin>>value;
        insertatend(head,value);
    }
    int pos;
    cin>>pos;
    if(pos!=-1){
        Node *cycleNode=head;
        Node *last =head;
        for(int i=0;i<pos;i++){
            cycleNode=cycleNode->next;
        }
        while(last->next!=NULL){
            last=last->next;
        }
        last->next=cycleNode;

    }
    if(DetectCycle(head)){
        cout<<"Yes There is a cycle";
    }else{
        cout<<"No Cycle";
    }
    return 0;
}
