#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int k;
    cin>>k;
    vector<int>ans;
    int left=0;
    for(int right=0;right<=n-k;right++){
        int maxi=nums[right];
        for(int j=right;j<right+k;j++){
            maxi=max(maxi,nums[j]);
        }
        ans.push_back(maxi);
    }
    for(int i=0;i<ans.size();i++){
        cout<<ans[i];
    }
    return 0;
}
