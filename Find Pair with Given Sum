#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int k;
    cin>>k;
    int left=0;
    int right=n-1;
    while(left<right){
        int sum=arr[left]+arr[right];
        if(sum==k){
            cout<<arr[left]<<" "<<arr[right];
            return 0;
        }
        else if(sum<k){
            left++;
        }
        else{
            right--;
        }
    }
    cout<<"No pair Found";
    return 0;
}
