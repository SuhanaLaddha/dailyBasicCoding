#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int sum=0;
    int k;
    cin>>k;
    for(int i=0;i<k;i++){
        sum+=nums[i];
    }
    int final=sum;
    for(int i=k;i<n;i++){
        sum+=nums[i];
        sum-=nums[i-k];
        final=min(sum,final);
    }
    cout<<final;
    return 0;
}
