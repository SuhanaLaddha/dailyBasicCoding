#include<bits/stdc++.h>
using namespace std;
void solve(string &s,int i,int j){
    if(i>=j)return;
    swap(s[i],s[j]);
    solve(s,i+1,j-1);
}
int main(){
    string s;
    cin>>s;
    //Through Recursion
    int n=s.length();
    solve(s,0,n-1);
    cout<<s;



