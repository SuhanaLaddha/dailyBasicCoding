#include<bits/stdc++.h>
using namespace std;
int main(){
    priority_queue<int,vector<int>,greater<int>>pq;
    int n;
    cin>>n;
    for(int i=0;i<n;i++){
        int x;
        cin>>x;
        pq.push(x);
    }
    int k;
    cin>>k;
    int count=0;
    while(count<k){
        cout<<pq.top()<<" ";
        pq.pop();
        count++;
    }
    return 0;
}
