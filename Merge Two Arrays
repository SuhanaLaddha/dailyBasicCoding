#include<bits/stdc++.h>
using namespace std;
void solve(vector<int>& nums1,vector<int>& nums2,int n,int m){
    int i=0;
    int j=0;
    int z=n+m;
    vector<int>ans;
    while(i<n && j<m){
        if(nums1[i]<=nums2[j]){
            ans.push_back(nums1[i]);
            i++;
        }
        else{
            ans.push_back(nums2[j]);
            j++;
        }
    }
    while(i<n){
        ans.push_back(nums1[i]);
        i++;
    }
    while(j<m){
        ans.push_back(nums2[j]);
        j++;
    }
    for(int i=0;i<z;i++){
        nums1[i]=ans[i];
    }
}
int main(){
    int n,m;
    cin>>n>>m;
    cout<<endl;
    vector<int> nums1(n+m);
    vector<int> nums2(m);
    for(int i=0;i<n;i++){
        cin>>nums1[i];
    }
    cout<<endl;
    for(int i=0;i<m;i++){
        cin>>nums2[i];
    }
    solve(nums1,nums2,n,m);
    for(int i=0;i<n+m;i++){
        cout<<nums1[i]<<" ";
    }
    return 0;


}
