#include<bits/stdc++.h>
using namespace std;
int solve(vector<int>& prefix,int L,int R){
    if(L==0)return 0;
    return prefix[R]-prefix[L-1];
}
int main(){
    int n;
    cin>>n;
    vector<int>arr(n);
    for(int i=0;i<n;i++){
        cin>>arr[i];
    }
    int l,r;
    cin>>l>>r;
    vector<int>prefix(n);
    prefix[0]=arr[0];
    for(int i=1;i<n;i++){
        prefix[i]=prefix[i-1]+arr[i];
    }
    cout<<solve(prefix,l,r);
    return 0;
}
