#include<bits/stdc++.h>
using namespace std;
struct TreeNode{
    int val;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x){
        val=x;
        left=NULL;
        right=NULL;
    }
};
TreeNode* create(int n){
    if(n==0){
        return 0;
    }
    int value;
    cin>>value;

    TreeNode* root=new TreeNode(value);
    queue<TreeNode*>q;
    q.push(root);
    int count=1;
    while(count<n){
        TreeNode* current=q.front();
        q.pop();
        cin>>value;
        current->left=new TreeNode(value);
        q.push(current->left);
        count++;
        cin>>value;
        current->right=new TreeNode(value);
        q.push(current->right);
        count++;
    }
    return root;

}
bool same(TreeNode* p,TreeNode* q){
    if(p== NULL && q==NULL){
        return true;
    }
    else if(p==NULL || q==NULL){
        return false;
    }
    else if(p->val!=q->val){
        return false;
    }
    return same(p->left,q->left)&&same(p->right,q->right);
}
int main(){
    int n,m;
    cin>>n>>m;
    TreeNode* p=create(n);
    TreeNode* q=create(m);
    if(same(p,q)){
        cout<<"True";
    }else{
        "False";
    }
    return 0;
}
