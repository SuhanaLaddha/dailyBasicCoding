#include<bits/stdc++.h>
using namespace std;
int main(){
    //To check a word is palindrome or not
    string s;
    cin>>s;
    int n=s.length();

    int i=0;
    int j=n-1;
    while(i<j){
        if(s[i]!=s[j]){
            cout<<"Not a palindrome";
            return 0;
        }
        i++;
        j--;
    }
    cout<<"Palindrome";
    return 0;
}
