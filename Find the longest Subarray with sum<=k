#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int>nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int k;
    cin>>k;
    
    int sum=0;
    int ans=0;
    int left=0;
    for(int right=0;right<n;right++){
        sum+=nums[right];
        while(sum>k){
            sum-=nums[left];
            left++;
        }
        ans=max(right-left+1,ans);
    }
    cout<<ans;
    return 0;
}
