#include<bits/stdc++.h>
using namespace std;
int main(){
    int n,m;
    cin>>n>>m;
    vector<vector<int>>mat(n,vector<int>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin>>mat[i][j];
        }
    }
    int maxi=-1;
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            maxi=max(maxi,mat[i][j]);
        }
    }
    cout<<maxi;
    return 0;
}
