#include<bits/stdc++.h>
using namespace std;
struct TreeNode{
    int val;
    TreeNode* left;
    TreeNode* right;
    TreeNode(int x){
        val=x;
        left=NULL;
        right=NULL;
    }
};
TreeNode* create(int n){
    if(n==0){
        return 0;
    }
    int value;
    cin>>value;
    TreeNode* root=new TreeNode(value);
    queue<TreeNode*>q;
    q.push(root);
    int count=1;
    while(count<n){
        TreeNode* current=q.front();
        q.pop();
        cin>>value;
        current->left=new TreeNode(value);
        q.push(current->left);
        count++;
        cin>>value;
        current->right=new TreeNode(value);
        q.push(current->right);
        count++;
    }
    return root;
}
void inorder(TreeNode* root){
    if(root==NULL){
        return; 
    }
    inorder(root->left);
    cout<<root->val<<" ";
    inorder(root->right);
}
TreeNode* invert(TreeNode* root){
    if(root==NULL){
        return NULL;
    }
    swap(root->left,root->right);
    invert(root->left);
    invert(root->right);
    return root;
}
int main(){
    int n;
    cin>>n;
    TreeNode* root=create(n);
    TreeNode* p=invert(root);
    inorder(p);
    return 0;
}
