#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    unordered_map<int,int>mp;
    for(int x:nums){
        mp[x]++;
    }
    int maxFreq=0;
    int ans=0;
    for(auto it:mp){
        if(it.second>maxFreq){
            maxFreq=it.second;
            ans=it.first;
        }
    }
    cout<<ans<<"->"<<maxFreq;
    return 0;
}
