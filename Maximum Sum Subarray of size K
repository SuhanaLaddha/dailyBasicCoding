#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin>>n;
    vector<int> nums(n);
    for(int i=0;i<n;i++){
        cin>>nums[i];
    }
    int k;
    cin>>k;
    int final=0;
    int ans=0;
    int left=0;
    for(int right=0;right<n;right++){
        ans+=nums[right];
        while((right-left+1)>k){
            ans-=nums[left];
            left++;
        }
        final=max(ans,final);
        
    }
    cout<<final;
    return 0;
}
